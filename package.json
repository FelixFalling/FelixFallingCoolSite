{
  "name": "felixfalling-site",
  "version": "1.0.0",
  "private": true,
  "description": "Personal portfolio / resume site, built with Next.js + TypeScript.",
  "scripts": {
    "dev": "next dev",
    "build": "next build && node scripts/csp.mjs",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "screenshots": "npm run build && node scripts/screenshots.mjs",
    "test": "playwright test",
    "test:ui": "playwright test --ui"
  },
  "dependencies": {
    "next": "^16.2.10",
    "react": "19.0.0",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.61.1",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.2.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.2.12",
    "sharp": "^0.35.3",
    "typescript": "5.7.3"
  }
}
